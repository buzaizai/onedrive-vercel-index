# Public values used by the OAuth preparation page and authorization URL.
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=
NEXT_PUBLIC_MICROSOFT_TENANT_ID=common
NEXT_PUBLIC_MICROSOFT_REDIRECT_URI=http://localhost

# Server-only value. Never expose or commit this secret.
MICROSOFT_CLIENT_SECRET=

# The Microsoft account that owns the OneDrive content.
NEXT_PUBLIC_USER_PRINCIPLE_NAME=

# Preferred direct Redis connection. For Upstash use the TLS rediss:// form.
REDIS_URL=

# Optional official Redis / Redis Cloud split configuration when REDIS_URL is unavailable.
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_TLS=true

# REST fallback used when the direct connection is unavailable.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional website entrance gate. Store only a scrypt password record and a separate cookie signing secret.
SITE_ACCESS_PASSWORD_HASH=
SITE_ACCESS_COOKIE_SECRET=

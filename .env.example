# Public values used by the OAuth preparation page and authorization URL.
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=
NEXT_PUBLIC_MICROSOFT_TENANT_ID=common
NEXT_PUBLIC_MICROSOFT_REDIRECT_URI=http://localhost

# Server-only value. Never expose or commit this secret.
MICROSOFT_CLIENT_SECRET=

# The Microsoft account that owns the OneDrive content.
NEXT_PUBLIC_USER_PRINCIPLE_NAME=

# Preferred Upstash Redis REST connection used by the token store.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Legacy fallback only when the Upstash REST variables are unavailable.
REDIS_URL=
